# Copia a .env.local y completa. Sin estas variables el admin corre en modo local (datos de ejemplo en memoria).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO servidor. Nunca con prefijo NEXT_PUBLIC_. La usa la landing para guardar solicitudes y consultar disponibilidad.
SUPABASE_SERVICE_ROLE_KEY=

# Modo local: secreto para firmar la sesión demo (texto largo) y permiso explícito de demo en producción.
ADMIN_SESSION_SECRET=
# ALLOW_DEMO_ADMIN=true

# Zona horaria de la consulta (por defecto America/Guayaquil)
# CLINIC_TZ=America/Guayaquil
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Avisos por correo al aceptar/rechazar solicitudes (Resend). Sin clave, solo se avisa por WhatsApp.
RESEND_API_KEY=
EMAIL_FROM=TANFIP <avisos@tu-dominio.com>

# Neon (Postgres). Si está definida, la app usa Neon en lugar de Supabase o del modo local en memoria.
DATABASE_URL=
# Panel de un solo usuario (con Neon): correo, contraseña y secreto de la sesión. Se definen en Vercel, nunca en el código.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Tania Castro
# Código de país para los enlaces de WhatsApp de pacientes en el panel (51 = Perú)
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=51

# Recordatorios por correo (Vercel Cron envia este secreto) y feed de calendario .ics. Textos largos aleatorios.
CRON_SECRET=
CALENDAR_TOKEN=
